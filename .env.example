# ==========================================================================
# resume-renderer — environment configuration
# Copy this file to `.env` and adjust as needed. All values are optional.
# ==========================================================================

# Logging
LOG_LEVEL=INFO

# CORS (comma-separated origins; "*" allows all). Only relevant for direct
# browser access. Server-to-server clients are unaffected.
CORS_ORIGINS=*

# Templates (comma-separated). classic | modern | executive are shipped.
SUPPORTED_TEMPLATES=classic,modern,executive
DEFAULT_TEMPLATE=classic

# PDF rendering (Playwright / Chromium)
# --no-sandbox is required on Render/container runtimes. Keep it true.
PLAYWRIGHT_NO_SANDBOX=true
# Absolute path to a custom Chromium/Chrome executable (optional).
PLAYWRIGHT_BROWSER_PATH=
# Timeout (ms) for loading a page before printing to PDF.
PLAYWRIGHT_RENDER_TIMEOUT_MS=30000

# PDF output
PDF_FORMAT=A4
PDF_PRINT_BACKGROUND=true
# Respect the CSS @page size/margins defined in the templates (recommended).
PDF_PREFER_CSS_PAGE_SIZE=true
